<?xml version="1.0" encoding="utf-8"?>
<!-- Server passwords never leave the device in backups or transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="servers.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="servers.json" />
    </device-transfer>
</data-extraction-rules>
