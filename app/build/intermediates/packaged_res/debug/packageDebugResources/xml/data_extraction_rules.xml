<?xml version="1.0" encoding="utf-8"?>
<!-- Server passwords never leave the device in backups or transfers; the sync identity belongs to this device only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="servers.json" />
        <exclude domain="sharedpref" path="fwip_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="servers.json" />
        <exclude domain="sharedpref" path="fwip_sync.xml" />
    </device-transfer>
</data-extraction-rules>
